{
  "name": "trip-map",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trip-map/web",
    "build": "npm run build -w @trip-map/web",
    "lint": "oxlint",
    "preview": "npm run preview -w @trip-map/web",
    "test": "npm test -w @trip-map/web",
    "test:e2e": "npm run test:e2e -w @trip-map/web",
    "check:maps": "npm run check:maps -w @trip-map/web",
    "download:maps": "npm run download:maps -w @trip-map/web",
    "prepare:regions": "npm run prepare:regions -w @trip-map/web",
    "prepare:coords": "npm run prepare:coords -w @trip-map/web",
    "prepare:search": "npm run prepare:search -w @trip-map/web",
    "prepare:map-colors": "npm run prepare:map-colors -w @trip-map/web",
    "prepare:share-geometry": "npm run prepare:share-geometry -w @trip-map/web"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
