{
  "name": "mono",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:trip-map": "npm run dev -w @kongken/trip-map",
    "dev:metro": "npm run dev -w @kongken/metro",
    "build": "npm run build --workspaces --if-present",
    "build:trip-map": "npm run build -w @kongken/trip-map",
    "build:metro": "npm run build -w @kongken/metro",
    "lint": "oxlint",
    "preview:trip-map": "npm run preview -w @kongken/trip-map",
    "preview:metro": "npm run preview -w @kongken/metro",
    "test": "npm test --workspaces --if-present",
    "test:trip-map": "npm test -w @kongken/trip-map",
    "test:metro": "npm test -w @kongken/metro",
    "test:e2e:trip-map": "npm run test:e2e -w @kongken/trip-map",
    "test:e2e:metro": "npm run test:e2e -w @kongken/metro",
    "check:maps": "npm run check:maps -w @kongken/trip-map",
    "download:maps": "npm run download:maps -w @kongken/trip-map",
    "prepare:regions": "npm run prepare:regions -w @kongken/trip-map",
    "prepare:coords": "npm run prepare:coords -w @kongken/trip-map",
    "prepare:search": "npm run prepare:search -w @kongken/trip-map",
    "prepare:map-colors": "npm run prepare:map-colors -w @kongken/trip-map",
    "prepare:share-geometry": "npm run prepare:share-geometry -w @kongken/trip-map"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
