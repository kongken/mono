{
  "name": "trip-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "download:maps": "node scripts/download-maps.mjs",
    "check:maps": "node scripts/prepare-region-catalog.mjs --check && node scripts/prepare-city-coords.mjs --check && node scripts/check-maps.mjs",
    "prepare:regions": "node scripts/prepare-region-catalog.mjs",
    "prepare:coords": "node scripts/prepare-city-coords.mjs",
    "prepare:search": "node scripts/prepare-search-index.mjs",
    "prepare:map-colors": "node scripts/prepare-province-neighbors.mjs",
    "prepare:share-geometry": "node scripts/prepare-share-geometry.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "radix-ui": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pinyin-pro": "^3.29.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
