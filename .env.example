# Backend, for running a service by hand (make dev sets these itself): the BFF on 18081
# with ./config.bff.yaml, tripmap on 18082 with ./config.tripmap.yaml.
BUTTERFLY_CONFIG_TYPE=file
BUTTERFLY_CONFIG_FILE_PATH=./config.tripmap.yaml
PORT=18082

# Optional Consul config (set these in the service process environment; make dev forces file mode).
# Replace BUTTERFLY_CONFIG_TYPE=file above with consul to enable.
# BUTTERFLY_CONFIG_TYPE=consul
# BUTTERFLY_CONFIG_CONSUL_ADDRESS=http://127.0.0.1:8500
# KV path prefix, default apps: apps/tripmap and apps/bff. No .yaml suffix.
# BUTTERFLY_NAMESPACE=kongken/prod
# Optional Consul API Namespace, independent of the KV path prefix:
# BUTTERFLY_CONFIG_CONSUL_NAMESPACE=team-a
# Each KV value contains the full service YAML; changes require a service restart.
# See docs/backend.md (Consul 配置与路径前缀).

# Frontend (Vite, read at build time).
# Backend API address. Leave unset to run the frontend standalone (local-only, no backend requests).
# Use /api with the Vite dev proxy or the front image's Nginx proxy, or an absolute http(s) URL.
# VITE_API_BASE_URL=/api
# Dev-server only (read by vite.config.ts): where /api is proxied, the BFF. Default http://127.0.0.1:18081.
# TRIPMAP_DEV_BACKEND=http://127.0.0.1:18081
# Optional OSM basemap tile source.
# VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSM_TILE_MAX_ZOOM=19
# VITE_OSM_TILE_ATTRIBUTION=
# Mapbox basemap through this site's own tile proxy (tripmap mapbox_tiles.enabled, see
# docs/backend.md). The Mapbox token lives only in the backend config; never put it here.
# Same-origin: /api/tiles/{z}/{x}/{y}.png. Cross-origin: the BFF's absolute address.
# VITE_OSM_TILE_URL=/api/tiles/{z}/{x}/{y}.png
# VITE_OSM_TILE_PROVIDER=mapbox
# Label of the style the proxy serves; must equal tripmap mapbox_tiles.style_version. Change both
# together when switching styles so browsers stop using cached tiles of the old style.
# VITE_OSM_TILE_VERSION=2026-10
