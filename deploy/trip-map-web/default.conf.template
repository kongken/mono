server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # BACKEND_UPSTREAM is the BFF, the entry in front of the business services. It is
    # resolved at request time, so the static site can start independently.
    resolver 127.0.0.11 valid=10s;
    set $backend_upstream "${BACKEND_UPSTREAM}";

    # Public share links. The backend answers /s/<token> with Open Graph tags (so link
    # previews work) and /api/share/<token>/... with data and photos. The token is the
    # credential, so these paths are never written to the access log, and the error log
    # (which records the request line) is limited to critical entries for them.
    # The backend still needs its own share.public_base_url and app_index_url.
    location ^~ /s/ {
        access_log off;
        error_log /dev/stderr crit;
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Referer "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location = /s {
        access_log off;
        error_log /dev/stderr crit;
        proxy_pass http://$backend_upstream$request_uri;
        proxy_set_header Host $host;
    }
    location ^~ /api/share/ {
        access_log off;
        error_log /dev/stderr crit;
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Referer "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Unsubscribe links in reminder emails carry a signed token in the query string.
    location ^~ /api/notifications/ {
        access_log off;
        error_log /dev/stderr crit;
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Referer "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Mail landing pages (verify email, reset password). The one-time token is in the URL
    # fragment, which the browser never sends; these pages must not be cached, must not leak
    # a Referer, and may only load scripts from this origin. add_header does not inherit once a
    # location sets its own, so the common headers are repeated.
    location ~ ^/account/(verify-email|reset-password)/?$ {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'" always;
        try_files /index.html =404;
    }

    # Map tiles are a public, anonymous GET: the BFF fetches them from tripmap (rate-limited by
    # client address) and no session is involved, so the product's own origin may serve them.
    location ^~ /api/tiles/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location ~ ^/(ping|readyz)$ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    # Nothing else of the BFF is reachable through this site. The session Cookie belongs to the API's
    # own host and OzID, the console and the products call that origin directly, so a same-origin
    # proxy of the BFF here would only be a second, unguarded door to the account and management
    # procedures (T12 removed it). The public paths above (share links, unsubscribe links, tiles) are
    # the product's own and need no session.
    location ^~ /api/ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /maps/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    # The retired browser login entry points are not routed anywhere: without this the SPA
    # fallback below would answer them with index.html and a 200.
    location ^~ /auth/ { return 404; }
    # The SPA entry page is also what every unknown path falls back to. add_header does not
    # inherit into a location that sets its own, so the common headers are repeated here.
    location = /index.html {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cache-Control "no-store" always;
    }
    # The push service worker must always be revalidated so updates reach browsers.
    location = /sw.js { add_header Cache-Control "no-cache"; }
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { try_files $uri $uri/ /index.html; }
    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
}
