server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # BACKEND_UPSTREAM is the BFF, the only public entry of the services. It is
    # resolved at request time, so the static site can start independently.
    resolver 127.0.0.11 valid=10s;
    set $backend_upstream "${BACKEND_UPSTREAM}";

    # Mail landing pages (verify email, reset password). The one-time token is in the URL
    # fragment, which the browser never sends; these pages must not be cached, must not leak
    # a Referer, and may only load scripts from this origin. add_header does not inherit once a
    # location sets its own, so the common headers are repeated.
    location ~ ^/account/(verify-email|reset-password)/?$ {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'" always;
        try_files /index.html =404;
    }

    # MCP endpoint for AI clients. The Bearer token is a credential, so no
    # request headers are logged by the BFF's own access log either; keep this
    # path out of the edge access log as well. Only POST is served by the BFF.
    # The BFF admits callers by BFF `mcp.allowed_cidrs`, reading X-Forwarded-For right to left; this
    # proxy appends the peer it sees, so its own network must be in BFF `mcp.trusted_proxies`.
    location = /mcp/metro {
        access_log off;
        error_log /dev/stderr crit;
        client_max_body_size 2m;
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # There is no /api here on purpose: the product calls the BFF's canonical public address (the session Cookie
    # belongs to that host and is shared with OzID), never a same-origin proxy of this site. Only the health
    # probes still pass through.
    location ~ ^/(ping|readyz)$ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    # A request for the retired same-origin API is refused, not answered by the single-page fallback.
    location ^~ /api/ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    # The retired browser login entry points are not routed anywhere: without this the SPA
    # fallback below would answer them with index.html and a 200.
    location ^~ /auth/ { return 404; }
    # The SPA entry page is also what every unknown path falls back to. add_header does not
    # inherit into a location that sets its own, so the common headers are repeated here.
    location = /index.html {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cache-Control "no-store" always;
    }
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { try_files $uri $uri/ /index.html; }
    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
}
