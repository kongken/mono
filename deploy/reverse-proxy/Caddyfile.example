# Same-origin edge: TLS termination + static SPA + BFF API on one site.
# Replace example.com and file paths. Mount Secrets at /secrets (see docs/deployment.md).

example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		# "?" = default only: a stricter value set inside a handle (the mail landing pages) wins.
		?Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Public share and unsubscribe paths (credentials in path or query).
	handle_path /s/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/share/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/notifications/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Mail landing pages: the one-time token is in the URL fragment (never sent to the server);
	# no caching, no Referer, scripts only from this origin.
	@landing path /account/verify-email /account/reset-password
	handle @landing {
		header {
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		}
		rewrite * /index.html
		root * /srv/www
		file_server
	}

	# Retired browser login entry points (the old /auth/login and /auth/callback/*): no route,
	# and no SPA fallback that would answer them with index.html.
	handle /auth/* {
		respond 404
	}

	# BFF Connect, health and probes (do not strip Connect or CSRF headers).
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	@probes path /ping /readyz
	handle @probes {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# SPA static files (build with --build-arg VITE_API_BASE_URL=/api). This must be its own
	# last `handle`: a site-level try_files runs before every handle and would rewrite /api,
	# /ping and the paths above to /index.html before they are matched.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

# metro (optional second product) on its own host. The MCP endpoint takes a Bearer
# token; keep it out of the access log. Everything else is the same as above.
metro.example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		# "?" = default only: a stricter value set inside a handle (the mail landing pages) wins.
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Mail landing pages: the one-time token is in the URL fragment (never sent to the server);
	# no caching, no Referer, scripts only from this origin.
	@landing path /account/verify-email /account/reset-password
	handle @landing {
		header {
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		}
		rewrite * /index.html
		root * /srv/metro
		file_server
	}

	handle /auth/* {
		respond 404
	}

	handle /mcp/metro {
		log_skip
		request_body {
			max_size 2MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	@probes path /ping /readyz
	handle @probes {
		reverse_proxy bff:18081
	}

	# SPA static files (build with --build-arg VITE_API_BASE_URL=/api). This must be its own
	# last `handle`: a site-level try_files runs before every handle and would rewrite /api,
	# /ping and the paths above to /index.html before they are matched.
	handle {
		root * /srv/metro
		try_files {path} /index.html
		file_server
	}
}

# OzID (user center) on the three sibling hosts of one site. The session Cookie is host-only on
# the API host: it is never given a Domain, and the browser sends it only to api.example.com.
# id.example.com and the product hosts call that API origin with credentials (the BFF's exact
# CORS list and Origin/CSRF checks are what keep an unlisted sibling out; see docs/bff.md).
# Build every front end for it: OzID with
#   --build-arg VITE_API_BASE_URL=https://api.example.com/api
# and set the BFF's navigation registry to the same origins (config.bff.example.yaml).
api.example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	@bff path /api/* /ping /readyz
	handle @bff {
		request_body {
			max_size 20MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		respond 404
	}
}

# The static OzID container (deploy/ozid-web); it sets its own security headers and CSP.
id.example.com {
	encode gzip zstd
	header -Server
	reverse_proxy ozid-web:80
}

# The management console (deploy/admin-web): the same site as the API, behind a source allowlist.
# Three independent layers say the same thing: this proxy (optional but cheap), the admin-web
# container (every page, asset and fallback) and the BFF (`admin.allowed_cidrs`, every console management
# call: user management and, since T8, the metro catalogue administration and the management tokens; the
# MCP endpoint /mcp/metro is not one of them). Edit them together. This proxy is the FIRST hop that sees the real client address, so it sets
# X-Forwarded-For from the TCP peer (a value the client sent is replaced, never passed on), and the
# other two list this proxy's network as a trusted proxy (ADMIN_TRUSTED_PROXIES / admin.trusted_proxies),
# a network that must NOT overlap the allowlist (both layers refuse to start otherwise).
# If a CDN or load balancer sits in front of this proxy, its address ranges become part of that
# trusted chain and Caddy's `trusted_proxies` global option must name them; otherwise leave it out.
# A source outside the list gets a bare 403 and no body; other Host names and ports get nothing here.
admin.example.com {
	encode gzip zstd
	header -Server

	@outside not remote_ip 203.0.113.0/24
	respond @outside 403

	reverse_proxy admin-web:80 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
