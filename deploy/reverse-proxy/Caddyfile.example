# Same-origin edge: TLS termination + static SPA + BFF API on one site.
# Replace example.com and file paths. Mount Secrets at /secrets (see docs/deployment.md).

example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		# "?" = default only: a stricter value set inside a handle (the mail landing pages) wins.
		?Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Public share and unsubscribe paths (credentials in path or query).
	handle_path /s/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/share/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/notifications/* {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Mail landing pages: the one-time token is in the URL fragment (never sent to the server);
	# no caching, no Referer, scripts only from this origin.
	@landing path /account/verify-email /account/reset-password
	handle @landing {
		header {
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		}
		rewrite * /index.html
		root * /srv/www
		file_server
	}

	# Retired browser login entry points (the old /auth/login and /auth/callback/*): no route,
	# and no SPA fallback that would answer them with index.html.
	handle /auth/* {
		respond 404
	}

	# BFF Connect, health and probes (do not strip Connect or CSRF headers).
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	@probes path /ping /readyz
	handle @probes {
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# SPA static files (build with --build-arg VITE_API_BASE_URL=/api). This must be its own
	# last `handle`: a site-level try_files runs before every handle and would rewrite /api,
	# /ping and the paths above to /index.html before they are matched.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

# metro (optional second product) on its own host. The MCP endpoint takes a Bearer
# token; keep it out of the access log. Everything else is the same as above.
metro.example.com {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		# "?" = default only: a stricter value set inside a handle (the mail landing pages) wins.
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Mail landing pages: the one-time token is in the URL fragment (never sent to the server);
	# no caching, no Referer, scripts only from this origin.
	@landing path /account/verify-email /account/reset-password
	handle @landing {
		header {
			Referrer-Policy no-referrer
			Cache-Control no-store
			Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		}
		rewrite * /index.html
		root * /srv/metro
		file_server
	}

	handle /auth/* {
		respond 404
	}

	handle /mcp/metro {
		log_skip
		request_body {
			max_size 2MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy bff:18081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	@probes path /ping /readyz
	handle @probes {
		reverse_proxy bff:18081
	}

	# SPA static files (build with --build-arg VITE_API_BASE_URL=/api). This must be its own
	# last `handle`: a site-level try_files runs before every handle and would rewrite /api,
	# /ping and the paths above to /index.html before they are matched.
	handle {
		root * /srv/metro
		try_files {path} /index.html
		file_server
	}
}
